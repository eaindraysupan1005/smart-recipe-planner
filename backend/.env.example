# Gemini (AI chef + receipt reading). Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model
# GEMINI_MODEL=gemini-3.5-flash

# Google sign-in (OAuth 2.0 authorization-code flow).
# Console: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if the app is not served from http://localhost:4000
# PUBLIC_URL=http://localhost:4000
