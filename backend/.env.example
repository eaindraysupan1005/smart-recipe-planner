# Gemini (AI chef + receipt reading). Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model
# GEMINI_MODEL=gemini-3.5-flash

# Supabase (Postgres). Leave both empty to keep using backend/data/db.json.
# Supabase dashboard → Project Settings → API (or "API Keys").
# The key is the secret one — service_role (or sb_secret_…). Backend only, never in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
